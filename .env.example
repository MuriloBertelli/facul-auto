# CampusFlow: modelo sem credenciais. Copie para .env somente no ambiente local.
# As variáveis VITE_ são públicas e entram no bundle do navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Vazio no desenvolvimento com proxy local. No Netlify: origem HTTPS real da API Java.
VITE_API_BASE_URL=

# Backend Java 21 / Spring Boot; nunca coloque segredos em VITE_*.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_OWNER_USER_ID=
CANVAS_BASE_URL=
CANVAS_API_TOKEN=
CANVAS_SUBMISSIONS_ENABLED=false
PORT=8080
# Origens exatas, separadas por vírgula. Acrescente a origem Netlify real quando existir.
APP_ALLOWED_ORIGINS=http://127.0.0.1:8888,http://localhost:8888
